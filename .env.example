# cp .env.example .env
# All config comes from these variables. Real secrets go in .env only, never here.

# Database. This default is the local postgres service in docker-compose.
# For Supabase use the Session pooler URI with ?sslmode=require on the end.
DATABASE_URL=postgresql://grid:grid@db:5432/grid

# Hour (UTC) on D-1 after which a forecast counts as hindsight. SPEC-1 §3.2.
DECISION_CUTOFF_HOUR_UTC=9

# Browser origins allowed to call the API, comma separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# Where the built frontend calls the API. Baked in at build time.
VITE_API_BASE_URL=http://localhost:8000
